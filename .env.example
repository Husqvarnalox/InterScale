# InferScale reads these from the process environment (it does not load .env itself).
# Example: set -a; source .env; set +a; inferscale serve
INFERSCALE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
INFERSCALE_DEVICE=auto
INFERSCALE_DTYPE=auto
INFERSCALE_MAX_BATCH_SIZE=8
INFERSCALE_MAX_QUEUE_SIZE=64
INFERSCALE_MAX_MODEL_LEN=2048
INFERSCALE_HOST=127.0.0.1
INFERSCALE_PORT=8000
INFERSCALE_LOG_LEVEL=info
